# ── CoC Platform · environment ──────────────────────────────────────────
# Copy this file to `.env.local` and fill in your NEW CoC Supabase project's
# values (NOT Lagoon's project). Find these in the Supabase dashboard under
# Project Settings → API.
#
# Until these are set, the site runs in "snapshot" mode (reads the bundled
# spreadsheet data). Once set, it reads live from your database.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
